[Unit]
Description=Kyuden daily collector (user)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/kyuden-data-collector
EnvironmentFile=-%h/kyuden-data-collector/secrets/kyuden.env
Environment=KYUDEN_PROFILE_DIR=%h/kyuden-data-collector/state/chrome-profile
Environment=KYUDEN_LOCK=%h/kyuden-data-collector/run/collector.lock
ExecStart=%h/kyuden-data-collector/.venv/bin/python %h/kyuden-data-collector/collector.py \
  -m daily --db %h/kyuden-data-collector/data/kyuden.sqlite
Restart=on-failure
RestartPreventExitStatus=20
RestartSec=10s
RuntimeMaxSec=300
